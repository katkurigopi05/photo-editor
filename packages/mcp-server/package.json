{
  "name": "@director/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "bin": {
    "director-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --target node20",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@director/canonical-json": "workspace:*",
    "@director/command-schema": "workspace:*",
    "@director/editor-state": "workspace:*",
    "@director/project-schema": "workspace:*",
    "@director/ui-kit": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  }
}
