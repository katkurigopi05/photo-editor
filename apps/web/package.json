{
  "name": "@director/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsup src/index.ts --format esm --dts --clean --target node20",
    "build:app": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@director/bg-segmentation": "workspace:*",
    "@director/command-schema": "workspace:^",
    "@director/editor-state": "workspace:*",
    "@director/export-engine": "workspace:*",
    "@director/playback-controller": "workspace:*",
    "@director/project-schema": "workspace:*",
    "@director/raster-tools": "workspace:*",
    "@director/ui-kit": "workspace:*",
    "gifenc": "^1.0.3",
    "hash-wasm": "^4.12.0",
    "mp4-muxer": "^5.2.2",
    "onnxruntime-web": "^1.20.1",
    "webm-muxer": "^5.1.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "vite": "^5.4.21"
  }
}
